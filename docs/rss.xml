        <title>sixth november, 2024, or, here is my advice</title>
        <link>https://goodenough.systems/2026/sixth-november-2024-or-here-is-my-advice/</link>
        <guid isPermaLink="true">https://goodenough.systems/2026/sixth-november-2024-or-here-is-my-advice/</guid>
